# SQLite file, relative to project root
DATABASE_URL=local.db

# Where uploaded originals, previews and thumbnails are written on disk
STORAGE_DIR=storage

# Used to build absolute links in magic-link emails
APP_URL=http://localhost:5173

# SMTP for sending magic-link emails. Leave empty in dev to log links to the console instead.
# SMTP_FROM's domain must match a domain your SMTP account has SPF/DKIM authorization for -
# sending "from" an unrelated domain (e.g. a domain with no SPF record at all) gets silently
# spam-filtered or dropped by the receiving provider even though your own server "accepts" it.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
